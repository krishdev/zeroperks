<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<link rel="shortcut icon" href="/images/favicon.png" />
<% if (typeof canonical != 'undefined') { %>
    <link rel="canonical" href="<%= canonical %>" />
<% } %>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="<%= description %>">
<meta name="keywords" content="<%= keywords %>">
<meta name="og:title" content="<%= title %>">
<meta name="og:description" content="<%= description %>">
<meta name="og:image" content="<%= origin+'/images/og-images/og-wide.jpg' %>">
<meta name="og:image" content="<%= origin+'/images/og-images/thumb.jpg' %>">
<% if (typeof image != 'undefined') { %>
<meta name="og:image" content="<%= aclPort + image %>">
<% } %>
<% if (typeof ogWide != 'undefined') { %>
    <meta name="og:image" content="<%= origin + ogWide %>">
<% } %>
<% if (typeof ogSquare != 'undefined') { %>
    <meta name="og:image" content="<%= origin + ogSquare %>">
<% } %>
<% if (typeof ogOtSquare != 'undefined') { %>
    <meta name="og:image" content="<%= aclPort + ogOtSquare %>">
<% } %>
<% if (typeof post != 'undefined') { %>
<script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "<%= canonical %>"
      },
      "headline": "<%= title %>",
      "description": "<%= description %>",
      "image": "<%= aclPort + image %>", 
      "author": {
        "@type": "Person",
        "name": "Krishna", 
        "url": "https://zeroperks.com/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "ZeroPerks",
        "logo": {
          "@type": "ImageObject",
          "url": "https://zeroperks.com/images/zeroperks-logo.png"
        }
      },
      "datePublished": "<%= new Date(post.createdAt).getFullYear() %>-<%= new Date(post.createdAt).toLocaleString('default', {month: 'short'}) %>-<%= new Date(post.createdAt).getDate() %>",
      "keywords": "<%= keywords %>"
    }
    </script>
    <% } %>