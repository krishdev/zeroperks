      </div>
      <!-- Feature 2 -->
      <div class="feature-item">
        <img src="images/icon-responsive.png" alt="Mobile-Responsive">
        <h3>Mobile-Responsive</h3>
        <p>Websites that look stunning on all devices.</p>
      </div>
      <!-- Feature 3 -->
      <div class="feature-item">
        <img src="images/icon-easy.png" alt="Easy to Update">
        <h3>Easy to Update</h3>
        <p>User-friendly interfaces for real-time updates.</p>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section id="portfolio">
    <h2>Our Work</h2>
    <div class="portfolio-gallery">
      <!-- Project 1 -->
      <div class="portfolio-item">
        <img src="images/project1.jpg" alt="Project 1">
        <div class="portfolio-overlay">
          <h3>Project Title 1</h3>
          <p>Brief description of the project.</p>
          <a href="#" class="btn">View Full Project</a>
        </div>
      </div>
      <!-- Repeat for other projects -->
    </div>
  </section>

  <!-- Testimonials -->
  <section id="testimonials">
    <h2>What Our Clients Say</h2>
    <div class="testimonial-carousel">
      <!-- Testimonial 1 -->
      <div class="testimonial-item">
        <p>"[Client testimonial highlighting their satisfaction with your services.]"</p>
        <h4>[Client Name]</h4>
      </div>
      <!-- Repeat for other testimonials -->
    </div>
  </section>

  <!-- About Us -->
  <section id="about">
    <h2>Who We Are</h2>
    <div class="about-content">
      <p>[Mission Statement: Describe your passion for creating beautiful event websites.]</p>
      <h3>Our Story</h3>
      <p>[Share how you started in this field and what sets you apart.]</p>
      <!-- Team Members (if applicable) -->
      <!--
      <div class="team-container">
        <div class="team-member">
          <img src="images/team1.jpg" alt="[Team Member Name]">
          <h4>[Team Member Name]</h4>
          <p>[Brief bio]</p>
        </div>
        <!-- Repeat for other team members --
      </div>
      -->
    </div>
  </section>

  <script>
    // Mobile Navigation Toggle
    const burger = document.querySelector('.burger');
    const navLinks = document.querySelector('.nav-links');

    burger.addEventListener('click', () => {
      navLinks.classList.toggle('nav-active');
      burger.classList.toggle('toggle');
    });

    // Contact Form Submission
    document.getElementById('contact-form').addEventListener('submit', function (e) {
      e.preventDefault();
      alert('Thank you for your message! We will get back to you soon.');
      // Handle form submission to the server here
      this.reset();
    });

  </script>