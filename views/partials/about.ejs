<%- contentFor('pageMeta') %>
    <%- include('../common/fragments/page-meta', { 
        title: 'ZEROPERKS',
        description: 'About Zeroperks website',
        keywords: 'ZEROPERKS',
    }) %>

<%- contentFor('topHead') %>
<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "AboutPage",
        "mainEntity": {
            "@type": "Organization",
            "name": "ZeroPerks",
            "url": "https://zeroperks.com",
            "logo": "https://zeroperks.com/images/zeroperks-logo.png",
            "description": "ZeroPerks is a platform providing insights, articles, and guidance on topics ranging from immigration, travel, and technology. Founded by Krishnakumar Rajendran, it offers valuable resources to its audience.",
            "founder": {
                "@type": "Person",
                "name": "Krishnakumar Rajendran",
                "url": "https://zeroperks.com/about",
                "sameAs": [
                    "https://www.linkedin.com/in/krishdev/",
                    "https://github.com/krishdev"
                ]
            }
        },
        "headline": "About ZeroPerks",
        "description": "Learn more about ZeroPerks, its mission.",
        "url": "https://zeroperks.com/about",
        "image": "https://zeroperks.com/images/zeroperks-logo.png",
        "publisher": {
            "@type": "Organization",
            "name": "ZeroPerks",
            "logo": {
                "@type": "ImageObject",
                "url": "https://zeroperks.com/images/zeroperks-logo.png"
            }
        }
    }
</script>

<%- contentFor('body') %>
    <%- include('../common/fragments/navbar') %>
    <main>
        <section class="o-Layout">
            <div class="c-Home__mid-panel">
                <span class="c-Home-mid-p__lt">ABOUT</span>
                <h1 class="c-Home-mid-p__h">ZEROPERKS</h1>
                <div class="c-About row">
                    <div class="col-sm-12 col-md-8 col-8">
                        <p>Zeroperks is a privately run, independent website dedicated to providing useful content, digital tools, and insights relevant to everyday needs — from informative articles and personal tech experiments to community-centered features like digital invitations and reminders.</p>
                        <p>Originally created as a learning and creative outlet, Zeroperks has steadily evolved into a space where thoughtful content and utility-based tools come together. The site includes a growing collection of topics ranging from immigration-related resources and personal automation experiments to helpful content for nonimmigrant communities in the U.S.</p>
                        <p>Zeroperks is not affiliated with any government agency, company, or organization. It does not accept ads, donations, or offer any services. All content is shared in good faith for informational purposes only.</p>
                        <p>Zeroperks LLC is a registered entity and may serve as the legal umbrella for this website, though the website itself operates independently without commercial intent.</p>
                    </div>
                    <figure class="col-sm-12 col-md-4 col-4">
                        <img src="/images/about.png" alt="hero-image" style="width: 100%;">
                    </figure>
                </div>
            </div>
        </section>
        <section class="c-Section-ultr-drk c-Home__sec">
            <div class="o-Layout">
                <h2>Experiment Projects</h2>
                <p class="c-Section__desc">Some of my seriously fun projects.</p>
                <div class="c-Repo-wrapper row">
                    <%  if (typeof allRepo != null) {
                        allRepo = JSON.parse(allRepo);
                        if (allRepo.length) {
                            for(let i = 0; i < allRepo.length; i++) { 
                                let thisRepo = allRepo[i];
                    %>
                    <div class="c-Repo col-sm-12 col-md-6 col-4">
                        <div class="c-Repo__body">
                            <a class="o-Icon-link" href="<%= thisRepo.html_url %>" target="_blank">
                                <i class="fas fa-folder"></i>
                            </a>
                            <h3 class="c-Repo__title"><%= thisRepo.name %></h3>
                            <% if (thisRepo.description != null) { %><p class="c-Repo__desc"><%- thisRepo.description %></p><% } %>
                        </div>
                    </div>
                    <% } } } %>

                    <div class="o-Btn-wrapper o-Btn-wrapper--center">
                        <a href="https://github.com/krishdev?tab=repositories" class="o-Btn-line">More on Github</a>
                    </div>
                </div>
            </div>
        </section>
    </main>